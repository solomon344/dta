# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dta?schema=public"

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the site, e.g. https://verify.dta.gm (used for auth and invite links)
BETTER_AUTH_URL="http://localhost:3000"

# One-time token required on /setup to create the first admin account.
# Remove it (or leave empty) after the first admin exists to disable /setup.
SETUP_TOKEN=""

# EdgeStore keys from https://dashboard.edgestore.dev
EDGESTORE_ACCESS_KEY=""
EDGESTORE_SECRET_KEY=""
